# Copy to .env for Docker Compose and replace every placeholder.
POSTGRES_DB=security_platform
POSTGRES_USER=security_app
POSTGRES_PASSWORD=replace-with-a-unique-local-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DEMO_ADMIN_PASSWORD=replace-with-unique-admin-password
DEMO_ANALYST_PASSWORD=replace-with-unique-analyst-password
DEMO_EMPLOYEE_PASSWORD=replace-with-unique-employee-password
DEMO_SARAH_PASSWORD=replace-with-unique-sarah-password
ENVIRONMENT=development

# PostgreSQL is required. Docker Compose configures the app connection URL.
