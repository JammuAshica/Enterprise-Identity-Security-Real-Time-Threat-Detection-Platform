# Environment Configuration for Enterprise Identity Security Platform

# Application
PROJECT_NAME="Enterprise Identity Security & Real-Time Threat Detection Platform"
ENVIRONMENT="development"
DEBUG=true
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL default, falls back to SQLite if unreachable or configured)
# For local Docker: postgresql://postgres:postgres@localhost:5432/security_platform
# For SQLite (zero setup testing/dev): sqlite:///./security_platform.db
DATABASE_URL="sqlite:///./security_platform.db"

# Security & JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Threat Detection Rules
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
BRUTE_FORCE_WINDOW_MINUTES=5
BRUTE_FORCE_THRESHOLD=5
IMPOSSIBLE_TRAVEL_SPEED_KMH=800.0
PRIVILEGE_ESCALATION_THRESHOLD=3

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
